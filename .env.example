# TaxiFlow environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
#
# Convention (per PLAN.md §3.4):
#   NEXT_PUBLIC_*  → safe to expose to the browser
#   (no prefix)    → server-only, never logged, never committed

# ── Supabase ──────────────────────────────────────────────────────────────────
# PUBLIC — Supabase project URL (anon requests go here)
NEXT_PUBLIC_SUPABASE_URL=

# PUBLIC — Supabase anon key (safe for browser, enforced by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY — Supabase service role key (bypasses RLS — never expose)
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ────────────────────────────────────────────────────────────────────
# PUBLIC — Stripe publishable key (used in browser for Stripe Elements)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SERVER-ONLY — Stripe secret key (used server-side for Payment Intents)
STRIPE_SECRET_KEY=

# SERVER-ONLY — Stripe webhook signing secret (for webhook verification)
STRIPE_WEBHOOK_SECRET=

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# SERVER-ONLY — Google Gemini API key
GEMINI_API_KEY=

# ── OpenRouteService ──────────────────────────────────────────────────────────
# SERVER-ONLY — OpenRouteService API key (for routing calculations)
ORS_API_KEY=
